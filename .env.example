# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Retry
GROQ_RETRY_MAX_ATTEMPTS=3
GROQ_RETRY_INITIAL_DELAY_SECONDS=1
GROQ_RETRY_BACKOFF_MULTIPLIER=2.0

# Agent
AGENT_MAX_ITERATIONS=10

# Memory
MEMORY_MAX_HISTORY_ROUNDS=2
MEMORY_ALLOWED_KEYS=user_name,favorite_music,occupation

# Prompt
PROMPT_NAME=system_prompt.txt
PROMPT_LANGUAGE=Traditional Chinese

# Tracing
TRACE_LOGGING_ENABLED=true
TRACE_JSON_FILE_PATH=logs/traces.jsonl

# Tool plugins
ENABLED_TOOL_PLUGINS=core

# Application
APP_SERVICE_NAME=Frank AI Agent
APP_VERSION=1.2.0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session
SESSION_TTL_SECONDS=3600
SESSION_CLEANUP_INTERVAL_SECONDS=300

# Retrieval
RETRIEVAL_ENABLED=false
RETRIEVAL_KNOWLEDGE_PATH=knowledge
RETRIEVAL_CHUNK_SIZE=500
RETRIEVAL_CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=-1.0
RETRIEVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TRIGGER_KEYWORDS=documentation,manual,session,deployment,architecture

# Logging
LOG_LEVEL=INFO