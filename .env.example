# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Retry
GROQ_RETRY_MAX_ATTEMPTS=3
GROQ_RETRY_INITIAL_DELAY_SECONDS=1
GROQ_RETRY_BACKOFF_MULTIPLIER=2.0

# Agent
AGENT_MAX_ITERATIONS=10

# Memory
MEMORY_MAX_HISTORY_ROUNDS=2
MEMORY_ALLOWED_KEYS=user_name,favorite_music,occupation

# Prompt
PROMPT_NAME=system_prompt.txt
PROMPT_USER_NAME=Frank
PROMPT_LANGUAGE=Traditional Chinese

# Tracing
TRACE_LOGGING_ENABLED=true
TRACE_JSON_FILE_PATH=logs/traces.jsonl

# Tool plugins
ENABLED_TOOL_PLUGINS=core